{
  "name": "<%= appName %>",
  "description": "",
  "version": "0.1.0",
  "author": "",
  "license": "",
  "homepage": "",
  "main": "<% if (staticSiteMode) { %>test-server.js<% } else { %>app.js<% } %>",
  "engines": {
    "node": ">=22.20.0"
  },
  "dependencies": <%- JSON.stringify(dependencies) %>,
  "devDependencies": {
    "standard": "~17.1.0",
    "stylelint": "~17.4.0",
    <%- stylelintPostCssModule -%>
    <%- stylelintConfigModule %>
  },
  "standard": {
    "ignore": [
      "public/"
    ]
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://somewhere.url/user/repo.git"
  },
  "scripts": {
    <% if (staticSiteMode) { %>
      "d": "node --watch test-server.js --development-mode",
      "dev": "node --watch test-server.js --development-mode",
      "development": "node --watch test-server.js --development-mode",
      "p": "node test-server.js --production-mode",
      "prod": "node test-server.js --production-mode",
      "production": "node test-server.js --production-mode",
      "build": "node test-server.js --build --production-mode",
      "build-dev": "node test-server.js --build --development-mode",
    <% } else { %>
      "d": "node --watch app.js --development-mode",
      "dev": "node --watch app.js --development-mode",
      "development": "node --watch app.js --development-mode",
      "p": "node app.js --production-mode",
      "prod": "node app.js --production-mode",
      "production": "node app.js --production-mode",
      "x": "node app.js --production-proxy-mode",
      "prodproxy": "node app.js --production-proxy-mode",
      "production-proxy": "node app.js --production-proxy-mode",
    <% } %>
    "lint": "npm run standard && npm run stylelint",
    "standard": "./node_modules/.bin/standard",
    "stylelint": "./node_modules/.bin/stylelint \"statics/css/**/*.<%= cssExt %>\"",
    "start": "<% if (staticSiteMode) { %>node test-server.js --production-mode<% } else { %>node app.js --production-mode<% } %>",
    "test": "npm run lint"
  }
}
